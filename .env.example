# =============================================================================
# .env.example — образец переменных окружения (стек FastAPI).
# Скопируйте в .env и подставьте свои значения:  cp .env.example .env
# Реальные секреты в репозиторий не коммитим.
# =============================================================================

# Режим отладки (в проде — false).
DEBUG=true

# Секрет для подписи JWT-токенов (в проде — длинная случайная строка!).
SECRET_KEY=change-me-in-production

# Подключение к БД PostgreSQL с PostGIS (синхронный драйвер psycopg3).
DATABASE_URL=postgresql+psycopg://led:led@localhost:5432/led_dashboard

# Адреса фронтенда (Flutter Web) для CORS, через запятую.
CORS_ORIGINS=http://localhost:8080,http://localhost:5000

# Время жизни access-токена (в минутах).
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Демо-учётка (историческая; вход теперь идёт по таблице users, эти значения на
# аутентификацию больше НЕ влияют — оставлены для обратной совместимости).
SUPERUSER_USERNAME=admin
SUPERUSER_PASSWORD=admin12345

# Bootstrap-админ (RBAC, NFR-8): при миграции 0007 гарантируется ≥1 админ.
# Идемпотентный upsert из этих переменных (нет — создаётся с role=admin; есть —
# промоутится до admin). Дефолты совпадают с прежней демо-учёткой admin/admin12345.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=admin12345

# --- Объектное хранилище файлов (S3/MinIO) ---
# INTERNAL — адрес хранилища для backend (put/delete). При запуске backend на
# хосте это localhost:9000; в docker-compose переопределяется на http://minio:9000.
# PUBLIC — адрес, до которого дотягивается браузер/устройство (под ним подписывается
# presigned-ссылка). В prod — публичный CDN/домен MinIO по HTTPS.
S3_BUCKET=led-attachments
S3_INTERNAL_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_REGION=us-east-1
S3_PRESIGN_EXPIRE_SECONDS=3600
