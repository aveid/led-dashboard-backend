# =============================================================================
# Dockerfile.minio — образ MinIO с автоматическим созданием бакета при старте.
#
# Зачем нужен отдельный образ, а не голый `minio/minio`:
#   backend ожидает существующий бакет S3_BUCKET=led-attachments сразу после
#   старта контейнера. Без этого файла бакет пришлось бы создавать вручную
#   через веб-консоль (:9001) или mc-клиент при каждом чистом поднятии стенда.
#
# Что делает: на старте контейнера entrypoint.sh поднимает сам MinIO-сервер
# в фоне, дожидается его готовности, создаёт бакет (если его ещё нет) через
# встроенный mc (mc уже есть в образе minio/minio), выставляет CORS/anonymous-
# download policy на бакет (нужно для presigned-превью из Flutter Web) и затем
# передаёт управление серверу на переднем плане.
# =============================================================================

# quay.io/minio/minio — docker.io/minio/minio больше не тянется анонимно
# (лицензионное изменение 2024, "pull access denied").
FROM quay.io/minio/minio:latest

# Имя бакета можно переопределить при билде: --build-arg BUCKET_NAME=other-bucket
ARG BUCKET_NAME=led-attachments
ENV BUCKET_NAME=${BUCKET_NAME}

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 9000 9001

ENTRYPOINT ["/entrypoint.sh"]